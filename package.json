{
  "name": "ghg-inventory-toolkit",
  "version": "0.1.0",
  "description": "Open-source greenhouse gas inventory calculator (Scope 1, 2, 3) for organisations in India",
  "scripts": {
    "test": "node --test tests/*.test.js",
